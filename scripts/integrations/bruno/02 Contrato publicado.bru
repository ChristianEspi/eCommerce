meta {
  name: 02 Contrato publicado
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/openapi.json
  body: none
  auth: none
}

docs {
  Especificación que la API real genera de su tabla de rutas. Solo en QAS: el
  servidor simulado sirve el contrato propuesto, no este.
}

tests {
  test("es OpenAPI y trae rutas", function () {
    expect(res.status).to.equal(200);
    expect(res.body.openapi).to.match(/^3\./);
    expect(Object.keys(res.body.paths).length).to.be.above(0);
  });
}
