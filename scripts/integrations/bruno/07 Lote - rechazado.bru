meta {
  name: 07 Lote - rechazado (422)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/catalog/products:batch?dry_run=true
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Prefer: code=422
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "products": [
      { "sku": "QS-ERR-001", "gtin": "4005800077930", "name": "GTIN con dígito de control inválido", "publications": [{ "store": "{{store}}", "price": "10.00" }] },
      { "sku": "QS-ERR-002", "name": "Categoría inexistente", "publications": [{ "store": "{{store}}", "category_slug": "no-existe", "price": "10.00" }] }
    ]
  }
}

script:pre-request {
  // Clave nueva en cada envío. Para probar la idempotencia, fijarla a mano.
  req.setHeader("Idempotency-Key", "bruno-" + Date.now() + "-" + Math.random().toString(36).slice(2, 10));
}

docs {
  Todo o nada: si una fila falla no se escribe ninguna.
  La cabecera Prefer: code=422 solo la usa el servidor simulado para forzar
  el ejemplo de rechazo; la API real la ignora.
}

tests {
  test("rechaza todo el lote con el detalle por fila", function () {
    expect(res.status).to.equal(422);
    expect(res.body.applied).to.equal(false);
    expect(res.body.summary.rejected).to.be.above(0);
    const withErrors = res.body.items.filter(function (i) { return i.status === "rejected"; });
    expect(withErrors[0].errors[0]).to.have.keys(["code", "field", "message"]);
  });
}
