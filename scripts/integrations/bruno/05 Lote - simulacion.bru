meta {
  name: 05 Lote - simulacion (dry_run)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/catalog/products:batch?dry_run=true
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "products": [
      {
        "sku": "QS-514574",
        "gtin": "4005800077937",
        "name": "Bloqueador Solar Eucerin FPS 50 Loción Textura Ligera 150 ml",
        "brand_code": "eucerin",
        "kind": "simple",
        "stock": 181,
        "custom_fields": { "codigo_qs": "514574", "linea": "BEIERSDORF" },
        "publications": [
          { "store": "{{store}}", "category_slug": "cuidado-de-la-piel", "status": "published", "price": "111.29", "compare_at_price": "130.93" }
        ]
      }
    ]
  }
}

script:pre-request {
  // Clave nueva en cada envío. Para probar la idempotencia, fijarla a mano.
  req.setHeader("Idempotency-Key", "bruno-" + Date.now() + "-" + Math.random().toString(36).slice(2, 10));
}

docs {
  Valida el lote y devuelve el informe fila por fila sin escribir nada.
  En QAS exige una credencial con el permiso catalog.write.
}

tests {
  test("simula sin escribir", function () {
    expect(res.status).to.equal(200);
    expect(res.body.summary.received).to.equal(1);
    expect(res.body.items[0].errors).to.have.length(0);
  });
}
